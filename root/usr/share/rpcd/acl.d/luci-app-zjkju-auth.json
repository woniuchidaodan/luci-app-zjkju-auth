{
	"luci-app-zjkju-auth": {
		"description": "Grant UCI access for luci-app-zjkju-auth",
		"read": {
			"uci": [ "zjkju-auth" ]
		},
		"write": {
			"uci": [ "zjkju-auth" ],
			"file": {
				"/etc/init.d/zjkju-auth restart": [ "exec" ],
				"/etc/init.d/zjkju-auth start": [ "exec" ],
				"/etc/init.d/zjkju-auth stop": [ "exec" ]
			}
		}
	}
}
